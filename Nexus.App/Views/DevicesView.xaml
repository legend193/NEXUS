<UserControl x:Class="Nexus.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DevicesViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="DEVICES CENTER" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="7 Hardware Controllers Connected &amp; Streaming" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource NexusPillButton}" Command="{Binding RefreshDevicesCommand}" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Re-scan Hardware" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 06 — 3-COLUMN DEVICE INVENTORY GRID (Exact Screen 06 Match) -->
            <ItemsControl ItemsSource="{Binding DeviceCards}" Margin="0,0,0,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Margin="4,0,4,12" Padding="16">
                            <StackPanel>
                                <!-- Top Bar: Title & Online Pill -->
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentGlowBrush}" Margin="0,0,8,0">
                                            <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                                  Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                            <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource TextMuted}" FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Online Pill -->
                                    <Border Background="#1A00E676" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource EmeraldGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Online" Foreground="{StaticResource EmeraldGreenBrush}" FontWeight="SemiBold" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Hardware Port & Firmware Details -->
                                <Border Background="#0D1018" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Port Bus:" Style="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding InterfaceBus}" Style="{StaticResource TextSubtle}" FontSize="10" FontWeight="Medium" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Firmware:" Style="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding FirmwareVersion}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Bottom Row: Settings & Action Buttons -->
                                <Grid>
                                    <Button Content="Settings" Style="{StaticResource NexusPillButton}" Height="28" Padding="12,0" FontSize="10" HorizontalAlignment="Left" />
                                    <Button Content="Calibrate" Style="{StaticResource NexusAccentButton}" Height="28" Padding="12,0" FontSize="10" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- LOGITECH G502 HERO SENSOR & DPI ENGINE CARD -->
            <Border Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Device Info & Current DPI Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentGlowBrush}" Margin="0,0,14,0">
                            <Path Data="{StaticResource IconMouseDevice}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                                  Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="Logitech G502 HERO" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="HERO 25.6K SENSOR" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hardware DPI Stages, Optical Tracking Engine &amp; Polling Rate Control" Style="{StaticResource TextSubtle}" FontSize="12" />
                        </StackPanel>

                        <!-- Large DPI Readout Display -->
                        <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDpi}" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,4,0" />
                                <TextBlock Text="DPI" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle: Quick DPI Preset Stages -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="Preset DPI Sensitivity Stages" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stage 1: 400 DPI -->
                            <Button Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource NexusPillButton}" Height="38"
                                    Command="{Binding SetDpiStageCommand}" CommandParameter="400">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stage 1: " Style="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="400" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Stage 2: 800 DPI -->
                            <Button Grid.Column="1" Margin="3,0,3,0" Style="{StaticResource NexusPillButton}" Height="38"
                                    Command="{Binding SetDpiStageCommand}" CommandParameter="800">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stage 2: " Style="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="800" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Stage 3: 1600 DPI -->
                            <Button Grid.Column="2" Margin="3,0,3,0" Style="{StaticResource NexusPillButton}" Height="38"
                                    Command="{Binding SetDpiStageCommand}" CommandParameter="1600">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stage 3: " Style="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="1600" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Stage 4: 3200 DPI -->
                            <Button Grid.Column="3" Margin="3,0,3,0" Style="{StaticResource NexusPillButton}" Height="38"
                                    Command="{Binding SetDpiStageCommand}" CommandParameter="3200">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stage 4: " Style="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="3200" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Stage 5: 6400 DPI -->
                            <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource NexusPillButton}" Height="38"
                                    Command="{Binding SetDpiStageCommand}" CommandParameter="6400">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stage 5: " Style="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="6400" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Bottom: Fine Slider & Polling Rate Selector -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Custom DPI Slider -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Custom Precision DPI (100 - 25,600)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CustomDpi, StringFormat={}{0} DPI}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="100" Maximum="25600" TickFrequency="50" IsSnapToTickEnabled="True"
                                        Value="{Binding CustomDpi, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Grid.Column="1" Style="{StaticResource NexusPillButton}" Content="Apply"
                                        Command="{Binding ApplyCustomDpiCommand}" Height="32" Padding="16,0" />
                            </Grid>
                        </StackPanel>

                        <!-- Polling Rate Selector -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="USB Report Rate" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedPollingRate, StringFormat={}{0} Hz}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <UniformGrid Columns="4" Rows="1">
                                <Button Style="{StaticResource NexusPillButton}" Height="32" Margin="0,0,3,0"
                                        Command="{Binding SetPollingRateCommand}" CommandParameter="125">
                                    <TextBlock Text="125" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource NexusPillButton}" Height="32" Margin="2,0,2,0"
                                        Command="{Binding SetPollingRateCommand}" CommandParameter="250">
                                    <TextBlock Text="250" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource NexusPillButton}" Height="32" Margin="2,0,2,0"
                                        Command="{Binding SetPollingRateCommand}" CommandParameter="500">
                                    <TextBlock Text="500" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource NexusPillButton}" Height="32" Margin="3,0,0,0"
                                        Command="{Binding SetPollingRateCommand}" CommandParameter="1000">
                                    <TextBlock Text="1000" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
