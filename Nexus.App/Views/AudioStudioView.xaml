<UserControl x:Class="Nexus.App.Views.AudioStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrl="clr-namespace:Nexus.App.Controls"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioStudioViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Geometry x:Key="IconStar">M 12,2 L 15.09,8.26 L 22,9.27 L 17,14.14 L 18.18,21.02 L 12,17.77 L 5.82,21.02 L 7,14.14 L 2,9.27 L 8.91,8.26 Z</Geometry>
        <Geometry x:Key="IconSparkles">M 12,2 L 13.5,8.5 L 20,10 L 13.5,11.5 L 12,18 L 10.5,11.5 L 4,10 L 10.5,8.5 Z M 19,16 L 20,18.5 L 22.5,19.5 L 20,20.5 L 19,23 L 18,20.5 L 15.5,19.5 L 18,18.5 Z</Geometry>

        <!-- Navigation Pill RadioButton Style -->
        <Style x:Key="SonarNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentGlowBrush}" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EQ Band Vertical Slider Style -->
        <Style x:Key="EqVerticalSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="4" CornerRadius="2" Background="#0A0B0F" BorderBrush="#1C1F2B" BorderThickness="1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="10" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="2" Background="{StaticResource AccentBrush}" BorderBrush="#FFFFFF" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">

            <!-- 01 — Top Header: Title & Subtitle -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audio Studio" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Fine-tune your audio experience" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- 02 — Navigation Pills Bar & Header Action Buttons -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Pills Bar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sonar Audio Studio Pill (Active Primary Tab) -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mixer}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Mixer">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAudio}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="SONAR AUDIO STUDIO" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Mixer Tab -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mixer}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Mixer">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSlidersTuning}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mixer" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Game Tab -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Game}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Game">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGameController}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Game" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Chat Tab -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Chat}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Chat">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconChatBubble}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Chat" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Media Tab -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Media}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Media">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMediaPlay}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Media" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Aux Tab -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Aux}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Aux">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAuxWaves}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Aux" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Mic Tab -->
                    <RadioButton Style="{StaticResource SonarNavTabStyle}"
                                 IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mic}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="Mic">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMicrophone}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Mic" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Right Side Quick Action Buttons: Pop-out & Reset -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NexusPillButton}" Command="{Binding PopoutMixerCommand}" Margin="0,0,8,0" Padding="12,6" ToolTip="Open floating Sonar mixer window">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPopout}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Pop-out" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetAllVolumesCommand}" Padding="12,6" ToolTip="Reset all volumes and levels">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Reset" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- TAB 1: MIXER (MAIN 6-CHANNEL RACK + EFFECTS + CHATMIX + PRESETS)           -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Mixer}">

                <!-- 03 — Main Card: Independent Audio Sources & Faders -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSlidersTuning}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Independent Audio Sources &amp; Faders" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SteelSeries Sonar Matrix Engine Active" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding PopoutMixerCommand}" Padding="3" Background="Transparent" BorderThickness="0" ToolTip="Pop-out Window">
                                    <Path Data="{StaticResource IconPopout}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 6-Channel Strips Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Channel 0: MASTER (Cyan/Blue #00D2FF) -->
                            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,14" Margin="0,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[0]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Header: Icon + MASTER -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconSpeaker}" Stroke="#00D2FF" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="MASTER" FontWeight="Bold" FontSize="12" Foreground="#00D2FF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Device Selector Dropdown -->
                                    <Border Grid.Row="1" Margin="0,0,0,14">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Select hardware output device" />
                                    </Border>

                                    <!-- Vertical Fader & Stereo VU Meter -->
                                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- dB Scale -->
                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="+6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <!-- Slider Fader (Colored track via Foreground) -->
                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#00D2FF" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />

                                        <!-- Stereo VU Meter -->
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Volume Text & Decibels Display -->
                                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- Dual Hardware Buttons: Mute & Solo -->
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="Mute Channel" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Channel 1: GAME (Emerald #10B981) -->
                            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,14" Margin="3,0,3,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[1]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="GAME" FontWeight="Bold" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,14">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Select game audio endpoint" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="+6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#10B981" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="Mute Channel" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Channel 2: CHAT (Cyan #00B4D8) -->
                            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,14" Margin="3,0,3,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[2]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CHAT" FontWeight="Bold" FontSize="12" Foreground="#00B4D8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,14">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Select chat audio endpoint" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="+6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#00B4D8" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="Mute Channel" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Channel 3: MEDIA (Rose/Pink #E11D48) -->
                            <Border Grid.Column="3" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,14" Margin="3,0,3,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[3]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconMediaPlay}" Fill="#E11D48" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="MEDIA" FontWeight="Bold" FontSize="12" Foreground="#E11D48" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,14">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Select media playback device" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="+6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#E11D48" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="Mute Channel" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Channel 4: AUX (Purple #A855F7) -->
                            <Border Grid.Column="4" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,14" Margin="3,0,3,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[4]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconAuxWaves}" Stroke="#A855F7" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="AUX" FontWeight="Bold" FontSize="12" Foreground="#A855F7" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,14">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Select aux output device" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="+6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#A855F7" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="Mute Channel" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Channel 5: MIC (Amber #F59E0B) -->
                            <Border Grid.Column="5" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="12,14" Margin="4,0,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[5]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconMicrophone}" Stroke="#F59E0B" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="MIC" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,14">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Select microphone input device" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="+6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#F59E0B" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="Mute Microphone" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 04 — Bottom Row: Audio Effects, ChatMix, Presets -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Audio Effects -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSparkles}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Audio Effects" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right" IsChecked="{Binding IsAudioEffectsEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 4 Effects Tiles -->
                            <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Center">
                                <!-- Noise Gate -->
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="NoiseGate" Padding="4,8" Margin="2" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconAuxWaves}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                        <TextBlock Text="Noise Gate" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Compressor -->
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Compressor" Padding="4,8" Margin="2" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPerformance}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                        <TextBlock Text="Compressor" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Equalizer (Active Cyan Glowing Tile) -->
                                <Border CornerRadius="8" Background="{StaticResource AccentGlowBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Margin="2" Height="68">
                                    <Button Command="{Binding SelectEffectCommand}" CommandParameter="Equalizer" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,8">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSlidersTuning}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                            <TextBlock Text="Equalizer" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Voice Clarity -->
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="VoiceClarity" Padding="4,8" Margin="2" Height="68">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconMicrophone}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                        <TextBlock Text="Voice Clarity" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Card 2: ChatMix -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,4,0" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconChatBubble}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="ChatMix" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <Slider Grid.Column="1" Style="{StaticResource SonarChatMixSlider}"
                                        Value="{Binding ChatMixSliderValue, Mode=TwoWay}"
                                        Minimum="-100" Maximum="100" Height="22" VerticalAlignment="Center" />

                                <Path Grid.Column="2" Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding ChatMixBalanceText}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <!-- Card 3: Presets -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,0" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconStar}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Presets" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SelectTabCommand}" CommandParameter="Game" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="View All" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <Path Data="{StaticResource IconChevronRight}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="8" Height="8" Stretch="Uniform" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Center">
                                <!-- Default Preset -->
                                <Border CornerRadius="8" Background="{StaticResource AccentGlowBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.2" Margin="3" Height="32">
                                    <Button Command="{Binding ApplyNamedPresetCommand}" CommandParameter="Flat" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Default" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Gaming Preset -->
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding ApplyNamedPresetCommand}" CommandParameter="Gaming" Content="Gaming" Margin="3" Height="32" FontSize="11" />

                                <!-- Streaming Preset -->
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding ApplyNamedPresetCommand}" CommandParameter="Vocals" Content="Streaming" Margin="3" Height="32" FontSize="11" />

                                <!-- Music Preset -->
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding ApplyNamedPresetCommand}" CommandParameter="Cinema" Content="Music" Margin="3" Height="32" FontSize="11" />
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 05 — Per-App Volume & Routing Matrix -->
                <Border Style="{StaticResource GlassCard}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDevices}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="App Routing Matrix" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Real-time Windows Process Audio Streams" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AppRoutings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#181C26" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- App Name -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessName}" FontSize="10" Style="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Channel Destination Selector -->
                                            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableChannelNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding ChannelName, Mode=TwoWay}"
                                                          Foreground="{StaticResource AccentBrush}"
                                                          FontWeight="SemiBold"
                                                          FontSize="11"
                                                          BorderThickness="0"
                                                          Background="Transparent" />
                                            </Border>

                                            <!-- Slider -->
                                            <Slider Grid.Column="3" Style="{StaticResource NexusSlider}" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- Percentage -->
                                            <TextBlock Grid.Column="4" Text="{Binding Volume, StringFormat={}{0:0}%}" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />

                                            <!-- Active Checkbox Toggle -->
                                            <CheckBox Grid.Column="5" IsChecked="{Binding IsChannelRouted, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 2: GAME (10-BAND PARAMETRIC EQUALIZER & SPATIAL AUDIO)                -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Game}">
                
                <!-- Presets & Spatial Audio Bar -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHeadphones}" Stroke="#10B981" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Game Presets &amp; Spatial Sound Engine" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetEqBandsCommand}" Content="Reset to Flat" HorizontalAlignment="Right" />
                        </Grid>

                        <WrapPanel Margin="0,0,0,14">
                            <ComboBox ItemsSource="{Binding EqualizerPresets}"
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Width="240" Height="32"
                                      Padding="10,4"
                                      Margin="0,0,12,0"
                                      Background="#111520"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center" />

                            <Border Background="#111520" CornerRadius="8" Padding="14,6" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="360 Spatial Audio" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsSpatialAudioEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111520" CornerRadius="8" Padding="14,6" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Smart Volume (Dialogue Boost)" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsSmartVolumeEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111520" CornerRadius="8" Padding="14,6" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Pre-Amp Gain" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Slider Style="{StaticResource NexusSlider}" Width="80" Minimum="-12" Maximum="6" Value="{Binding EqPreAmpGainDb, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EqPreAmpGainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Bass Boost Slider -->
                        <Grid Background="#0C0E14" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bass Boost Level" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,16,0" />
                            <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding BassBoostAmount, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding BassBoostAmount, StringFormat={}{0:0}%}" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 10-Band Graphic Equalizer Faders & Live Curve -->
                <Border Style="{StaticResource GlassCard}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Parametric Equalizer (10-Band Precision EQ)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="-15 dB to +15 dB • Live Frequency Response" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Real-Time Frequency Response Curve Visualizer -->
                        <Border Background="#090C13" CornerRadius="10" Padding="12,8" Margin="0,0,0,18" BorderBrush="#1C2433" BorderThickness="1" Height="150">
                            <Grid ClipToBounds="True">
                                <!-- Grid Reference Lines -->
                                <Line X1="0" Y1="22" X2="900" Y2="22" Stroke="#131A26" StrokeThickness="1" StrokeDashArray="4 2" />
                                <Line X1="0" Y1="48" X2="900" Y2="48" Stroke="#131A26" StrokeThickness="1" StrokeDashArray="4 2" />
                                <Line X1="0" Y1="75" X2="900" Y2="75" Stroke="#233247" StrokeThickness="1.5" />
                                <Line X1="0" Y1="102" X2="900" Y2="102" Stroke="#131A26" StrokeThickness="1" StrokeDashArray="4 2" />
                                <Line X1="0" Y1="128" X2="900" Y2="128" Stroke="#131A26" StrokeThickness="1" StrokeDashArray="4 2" />

                                <TextBlock Text="+12 dB" FontSize="8" Foreground="#475569" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,16,0,0" />
                                <TextBlock Text="0 dB" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,68,0,0" />
                                <TextBlock Text="-12 dB" FontSize="8" Foreground="#475569" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,122,0,0" />

                                <!-- Glow Fill Under Curve -->
                                <Path Data="{Binding EqCurveFillData}" Stretch="Fill" Opacity="0.16">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00D2FF" Offset="0.0" />
                                            <GradientStop Color="#000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <!-- Live Interactive Vector Curve -->
                                <Path Data="{Binding EqCurvePathData}" Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#00D2FF" Opacity="0.8" ShadowDepth="0" />
                                    </Path.Effect>
                                </Path>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding EqualizerBands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <Slider Style="{StaticResource EqVerticalSlider}" Value="{Binding GainDb, Mode=TwoWay}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding FrequencyLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 3: CHAT (VOICE COMMS & CLEARCAST AI)                                  -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Chat}">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Voice Communications &amp; ClearCast AI" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- ClearCast AI Noise Cancellation Card -->
                        <Border Background="#10141D" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#1C2838" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ClearCast AI Noise Cancellation" FontWeight="Bold" Foreground="#00B4D8" FontSize="12" />
                                        <TextBlock Text=" (Removes keyboard clatter and fan noise in real time)" Style="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsClearCastAiEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Reduction Strength" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding ClearCastStrength, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClearCastStrength, StringFormat={}{0:0}%}" Foreground="#00B4D8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Vocal Intelligibility Tuning -->
                        <Border Background="#10141D" CornerRadius="10" Padding="16" BorderBrush="#1C2838" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Vocal Warmth &amp; Presence Tuning" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Pre-calibrated 1kHz - 4kHz frequency enhancement delivers crystal-clear team communication in Discord and game lobbies." Style="{StaticResource TextSubtle}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 4: MEDIA (MUSIC, VIDEO & HIGH-FIDELITY AUDIO)                          -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Media}">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMediaPlay}" Fill="#EC4899" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Media &amp; Music Audio Engine" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border Background="#2B0E1E" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">
                                <TextBlock Text="Hi-Fi Media Profile" Foreground="#EC4899" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>

                        <!-- Media Smart Volume & Bass Enhancement -->
                        <Border Background="#130D18" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#3B1C2E" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Smart Volume (Dialogue Leveler)" FontWeight="Bold" Foreground="#EC4899" FontSize="12" />
                                        <TextBlock Text=" (Normalizes loud explosions and clarifies quiet dialog)" Style="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsSmartVolumeEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Deep Bass Punch" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding BassBoostAmount, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BassBoostAmount, StringFormat={}{0:0}%}" Foreground="#EC4899" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Media Spatial Immersion -->
                        <Border Background="#130D18" CornerRadius="10" Padding="16" BorderBrush="#3B1C2E" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Virtual Cinema &amp; Music Surround Sound" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Expands the stereo acoustic stage into an immersive 3D surround soundstage while preserving tonal accuracy." Style="{StaticResource TextSubtle}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 5: AUX (SECONDARY & STREAMING ROUTING)                                -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Aux}">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAuxWaves}" Stroke="#A855F7" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Auxiliary &amp; Streaming Background Stream" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border Background="#201030" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">
                                <TextBlock Text="Secondary Bus Active" Foreground="#A855F7" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>

                        <Border Background="#120B1C" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#341E47" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Dedicated AUX Channel Usage" FontWeight="Bold" Foreground="#A855F7" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Isolates secondary applications such as soundboards, browser audio, and streaming monitors independently from game and chat mixes." Style="{StaticResource TextSubtle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#2A1640" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock Text="Virtual Device Isolation" FontSize="10" Foreground="#C084FC" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#2A1640" CornerRadius="5" Padding="8,3">
                                        <TextBlock Text="OBS Clean Feed Protection" FontSize="10" Foreground="#C084FC" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 6: MIC (BROADCAST MIC DSP SUITE)                                      -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Mic}">
                <Border Style="{StaticResource GlassCard}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMicrophone}" Stroke="#F59E0B" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Broadcast Microphone Studio &amp; DSP Suite" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border Background="#251705" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">
                                <TextBlock Text="Low-Latency DSP Active" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>

                        <!-- Mic Monitoring (Sidetone) -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mic Monitoring (Sidetone)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Zero-latency audio feedback in your headset to monitor vocal delivery" Style="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsMicMonitoringEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 1. Input Gain -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Input Gain" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="-12 dB to +12 dB" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding MicGainDb, Mode=TwoWay}" Minimum="-12" Maximum="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding MicGainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. Noise Gate -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Noise Gate Threshold" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Mutes signals below this threshold" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding NoiseGateThresholdDb, Mode=TwoWay}" Minimum="-60" Maximum="-10" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding NoiseGateThresholdDb, StringFormat={}{0:0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 3. Compressor -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Compressor Threshold" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Levels out high and low vocal dynamics" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" Minimum="-30" Maximum="-5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CompressorThresholdDb, StringFormat={}{0:0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 4. Brickwall Limiter -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Limiter Ceiling" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Prevents harsh clipping distortion during shout peaks" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding LimiterCeilingDb, Mode=TwoWay}" Minimum="-6" Maximum="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding LimiterCeilingDb, StringFormat={}{0:0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>