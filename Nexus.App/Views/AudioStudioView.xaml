<UserControl x:Class="Nexus.App.Views.AudioStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrl="clr-namespace:Nexus.App.Controls"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioStudioViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Tab RadioButton Style -->
        <Style x:Key="SonarNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentGlowBrush}" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EQ Band Vertical Slider Style -->
        <Style x:Key="EqVerticalSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="4" CornerRadius="2" Background="#0A0B0F" BorderBrush="#1C1F2B" BorderThickness="1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="10" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="2" Background="{StaticResource AccentBrush}" BorderBrush="#FFFFFF" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header & Navigation Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Ecosystem Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="12,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="SONAR AUDIO STUDIO" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Studio Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الميكسر (Mixer)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mixer}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Mixer" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الألعاب (Game EQ)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Game EQ}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Game EQ" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="المحادثة (Chat EQ)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Chat EQ}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Chat EQ" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="المايك (Mic Studio)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mic Studio}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Mic Studio" />
                    </StackPanel>

                    <!-- Quick Global Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding MuteAllChannelsCommand}" Margin="0,0,6,0" Padding="8,4" Content="كتم الكل" FontSize="11" />
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetAllVolumesCommand}" Margin="0,0,6,0" Padding="8,4" Content="إعادة ضبط" FontSize="11" />
                        <Button Style="{StaticResource NexusAccentButton}" Command="{Binding RefreshSessionsCommand}" Height="28" Padding="10,3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="تحديث" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- TAB 1: MIXER (MAIN 6-CHANNEL RACK + CHATMIX + ROUTING)                    -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Mixer}">

                <!-- ChatMix Centerpiece Widget (SteelSeries Sonar Dual Deck) -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#10B981" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="CHATMIX موازنة الألعاب والمحادثة" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="#132B20" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="HARDWARE CROSSFADE" FontSize="9" FontWeight="SemiBold" Foreground="#34D399" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SetChatMixBalanceCommand}" CommandParameter="0" Content="100% اللعبة" Margin="0,0,6,0" Height="26" Padding="10,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SetChatMixBalanceCommand}" CommandParameter="25" Content="تركيز اللعبة (75/25)" Margin="0,0,6,0" Height="26" Padding="10,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetChatMixCommand}" Content="متوازن (50/50)" Margin="0,0,6,0" Height="26" Padding="10,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SetChatMixBalanceCommand}" CommandParameter="75" Content="تركيز المحادثة (25/75)" Margin="0,0,6,0" Height="26" Padding="10,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SetChatMixBalanceCommand}" CommandParameter="100" Content="100% المحادثة" Height="26" Padding="10,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#11241C" CornerRadius="8" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center" BorderBrush="#1C382B" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="GAME AUDIO" FontWeight="Bold" Foreground="#10B981" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Channels[1].Volume, StringFormat={}  {0:0}%}" FontWeight="SemiBold" Foreground="#34D399" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <Slider Grid.Row="0" Style="{StaticResource SonarChatMixSlider}" Value="{Binding ChatMixValue, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                
                                <Grid Grid.Row="1" Margin="2,4,2,0">
                                    <TextBlock Text="100% Game" FontSize="9" Foreground="#64748B" HorizontalAlignment="Left" />
                                    <TextBlock Text="50/50 Balanced" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <TextBlock Text="100% Chat" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>

                            <Border Grid.Column="2" Background="#102530" CornerRadius="8" Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Center" BorderBrush="#163442" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Channels[2].Volume, StringFormat={}{0:0}%  }" FontWeight="SemiBold" Foreground="#22D3EE" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="VOICE CHAT" FontWeight="Bold" Foreground="#00B4D8" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 6-Channel Mixer Rack -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAudio}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="قنوات الصوت الاحترافية (Independent Audio Sources &amp; Faders)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#10B981" Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SteelSeries Sonar Matrix Engine Active" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 6-Columns Channel Strips Grid -->
                        <Grid MinHeight="440">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Channel 0: MASTER (Cobalt Blue #3B82F6) -->
                            <Border Grid.Column="0" Background="#0F131D" CornerRadius="12" Padding="10,12" Margin="0,0,4,0" BorderBrush="#253556" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[0]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Channel Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconSpeaker}" Stroke="#3B82F6" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="MASTER" FontWeight="Bold" FontSize="12" Foreground="#3B82F6" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Independent Audio Device Dropdown -->
                                    <Border Grid.Row="1" Margin="0,0,0,6">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="اختر مخرج الصوت المخصص لقناة الماستر" />
                                    </Border>

                                    <!-- Tag Badge -->
                                    <Border Grid.Row="2" Background="#162238" CornerRadius="4" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EndpointStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="#60A5FA" />
                                    </Border>

                                    <!-- Vertical Fader, dB Scale & Stereo VU Meter -->
                                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- dB Scale Reference Labels -->
                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Volume Text & Decibels Display -->
                                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,6">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Dual Hardware Buttons: Mute (M) & Solo (S) -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="كتم القناة (Mute)" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="عزل القناة (Solo)" />
                                    </StackPanel>

                                    <!-- Bottom Label / Apps Tray -->
                                    <Border Grid.Row="6" Background="#162033" CornerRadius="6" Padding="6,4">
                                        <TextBlock Text="MAIN MIX OUT" FontSize="9" FontWeight="SemiBold" Foreground="#3B82F6" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 1: GAME (Emerald #10B981) -->
                            <Border Grid.Column="1" Background="#0F1517" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#1C382B" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[1]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="GAME" FontWeight="Bold" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,6">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="اختر مخرج الصوت المخصص لقناة الألعاب" />
                                    </Border>

                                    <Border Grid.Row="2" Background="#132B20" CornerRadius="4" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EndpointStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="#34D399" />
                                    </Border>

                                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,6">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="كتم القناة (Mute)" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="عزل القناة (Solo)" />
                                    </StackPanel>

                                    <!-- Apps Mini Tray (Drop Target) -->
                                    <Border Grid.Row="6" Background="#11241C" CornerRadius="6" Padding="6,4" MinHeight="26"
                                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Game Channel">
                                        <ItemsControl ItemsSource="{Binding AssignedApps}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="20" Height="20" CornerRadius="4" Margin="2,0" Background="#193327"
                                                            ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                            MouseMove="AppIcon_MouseMove"
                                                            MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                        <Image Source="{Binding Icon}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 2: CHAT (Electric Cyan #00B4D8) -->
                            <Border Grid.Column="2" Background="#0C141A" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#163442" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[2]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CHAT" FontWeight="Bold" FontSize="12" Foreground="#00B4D8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1" Margin="0,0,0,6">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="اختر مخرج الصوت المخصص لقناة المحادثة (Discord / Teams)" />
                                    </Border>

                                    <Border Grid.Row="2" Background="#102530" CornerRadius="4" Padding="6,2" Margin="0,0,0,8" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EndpointStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="#22D3EE" />
                                    </Border>

                                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
