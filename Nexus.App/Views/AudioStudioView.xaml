<UserControl x:Class="Nexus.App.Views.AudioStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrl="clr-namespace:Nexus.App.Controls"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioStudioViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Audio Mixer Header Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="AUDIO MIXER" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSpeaker}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="SteelSeries Sonar Engine Active (Low-Latency WASAPI)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetAllVolumesCommand}" Margin="0,0,8,0" Content="Reset Levels" />
                        <Button Style="{StaticResource NexusAccentButton}" Command="{Binding RefreshSessionsCommand}" Height="32" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh Streams" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Top Row: 5 Vertical Channel Strips (Left) & Master Device / Meters (Right) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: 5 Channel Faders Strip Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAudio}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Volume" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Hardware Faders" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- 5 Faders Columns Grid -->
                        <Grid Height="240">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Channel 1: Master -->
                            <Border Grid.Column="0" Background="#111520" CornerRadius="10" Padding="8,10" Margin="0,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[0]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="{StaticResource IconSpeaker}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    
                                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="10" Height="140" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <Button Grid.Row="3" Style="{StaticResource NexusPillButton}" Command="{Binding ToggleMuteCommand}" Height="24" Padding="8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Master" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Channel 2: Game -->
                            <Border Grid.Column="1" Background="#111520" CornerRadius="10" Padding="8,10" Margin="4,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[1]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="{StaticResource IconGameController}" Stroke="{StaticResource EmeraldGreenBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    
                                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="10" Height="140" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <Button Grid.Row="3" Style="{StaticResource NexusPillButton}" Command="{Binding ToggleMuteCommand}" Height="24" Padding="8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Game" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Channel 3: Voice / Chat -->
                            <Border Grid.Column="2" Background="#111520" CornerRadius="10" Padding="8,10" Margin="4,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[2]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="{StaticResource IconChatBubble}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    
                                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="10" Height="140" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <Button Grid.Row="3" Style="{StaticResource NexusPillButton}" Command="{Binding ToggleMuteCommand}" Height="24" Padding="8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Chat" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Channel 4: Media -->
                            <Border Grid.Column="3" Background="#111520" CornerRadius="10" Padding="8,10" Margin="4,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[3]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="{StaticResource IconMediaPlay}" Fill="{StaticResource AccentPurpleBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    
                                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="10" Height="140" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <Button Grid.Row="3" Style="{StaticResource NexusPillButton}" Command="{Binding ToggleMuteCommand}" Height="24" Padding="8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Media" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Channel 5: Aux -->
                            <Border Grid.Column="4" Background="#111520" CornerRadius="10" Padding="8,10" Margin="4,0,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[4]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Path Grid.Row="0" Data="{StaticResource IconAuxWaves}" Stroke="{StaticResource AmberGoldBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    
                                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" HorizontalAlignment="Center" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="10" Height="140" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <Button Grid.Row="3" Style="{StaticResource NexusPillButton}" Command="{Binding ToggleMuteCommand}" Height="24" Padding="8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Aux" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Master Devices & Multi-Segment dB Level VU Meter -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,0,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Master Output &amp; Routing" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="WASAPI Exclusive" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Output Device Selector Card -->
                        <TextBlock Text="Output device" Style="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Border Background="#111520" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{Binding SelectedPlaybackDevice.Name, FallbackValue='Headset Earphone (HyperX Cloud Alpha Wireless)'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                                <Path Data="{StaticResource IconChevronDown}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="10" Height="6" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Input Device Selector Card -->
                        <TextBlock Text="Input device" Style="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Border Background="#111520" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{Binding SelectedRecordingDevice.Name, FallbackValue='HyperX QuadCast S Microphone'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                                <Path Data="{StaticResource IconChevronDown}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="10" Height="6" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Audio Device Master dB Meter -->
                        <Border Background="#111520" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Audio device level" Style="{StaticResource TextSubtle}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="Output dB Peak" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="10" />
                                </Grid>

                                <!-- Level Bar with Green -> Amber -> Red segments -->
                                <Border Height="18" Background="#0A0C12" CornerRadius="4" Padding="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <!-- Gradient Level Bar Fill -->
                                        <Rectangle HorizontalAlignment="Left" Width="200" RadiusX="3" RadiusY="3">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00E676" Offset="0.0" />
                                                    <GradientStop Color="#00E676" Offset="0.65" />
                                                    <GradientStop Color="#FFB703" Offset="0.85" />
                                                    <GradientStop Color="#FF1744" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="-60 dB" Style="{StaticResource TextMuted}" FontSize="9" />
                                    <TextBlock Text="-12 dB" Style="{StaticResource TextMuted}" FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock Text="0 dB (Peak)" Style="{StaticResource TextMuted}" FontSize="9" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: App Audio (Left) & Per-App Routing (Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Audio Sliders -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="App audio" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Volume Control" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Dynamic App Audio Volume List -->
                        <ItemsControl ItemsSource="{Binding AppRoutings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="2" Style="{StaticResource NexusSlider}" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat={}{0:0}%}" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" Width="36" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Per App Routing Cards -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,0,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Per app routing" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Channel Assignment" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Dynamic App Channel Routing List -->
                        <ItemsControl ItemsSource="{Binding AppRoutings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Background="{StaticResource AccentGlowBrush}" CornerRadius="6" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChannelName}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsChannelRouted, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
