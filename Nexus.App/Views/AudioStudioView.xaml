<UserControl x:Class="Nexus.App.Views.AudioStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrl="clr-namespace:Nexus.App.Controls"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioStudioViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Tab RadioButton Style -->
        <Style x:Key="SonarNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentGlowBrush}" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EQ Band Vertical Slider Style -->
        <Style x:Key="EqVerticalSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="4" CornerRadius="2" Background="#0A0B0F" BorderBrush="#1C1F2B" BorderThickness="1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="10" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="2" Background="{StaticResource AccentBrush}" BorderBrush="#FFFFFF" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header & Navigation Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Ecosystem Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="12,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="SONAR AUDIO STUDIO" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Studio Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الميكسر العام (Mixer)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mixer}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Mixer" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="معادل الألعاب (Game EQ)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Game EQ}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Game EQ" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="معادل المحادثة (Chat EQ)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Chat EQ}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Chat EQ" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="استوديو المايكروفون (Mic Studio)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mic Studio}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Mic Studio" />
                    </StackPanel>

                    <!-- Quick Global Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding MuteAllChannelsCommand}" Margin="0,0,8,0" Content="كتم الكل (Mute All)" />
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetAllVolumesCommand}" Margin="0,0,8,0" Content="إعادة ضبط (Reset)" />
                        <Button Style="{StaticResource NexusAccentButton}" Command="{Binding RefreshSessionsCommand}" Height="32" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="تحديث المسارات" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- TAB 1: MIXER (MAIN 6-CHANNEL RACK + CHATMIX + ROUTING)                    -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Mixer}">

                <!-- ChatMix Centerpiece Widget -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="20,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="CHATMIX موازنة الألعاب والمحادثة" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SetChatMixBalanceCommand}" CommandParameter="25" Content="تركيز اللعبة (75/25)" Margin="0,0,6,0" Height="24" Padding="8,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetChatMixCommand}" Content="متوازن (50/50)" Margin="0,0,6,0" Height="24" Padding="8,0" />
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding SetChatMixBalanceCommand}" CommandParameter="75" Content="تركيز المحادثة (25/75)" Height="24" Padding="8,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border Background="#10B981" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="GAME" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                            </StackPanel>

                            <Slider Grid.Column="1" Style="{StaticResource SonarChatMixSlider}" Value="{Binding ChatMixValue, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="CHAT" FontWeight="Bold" Foreground="#00B4D8" FontSize="12" Margin="0,0,6,0" />
                                <Border Background="#00B4D8" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 6-Channel Mixer Rack -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAudio}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="قنوات الصوت الاحترافية (Hardware Mixer Channels)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="SteelSeries Sonar Precision Faders" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 6-Columns Channel Strips Grid -->
                        <Grid Height="340">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Channel 0: MASTER (Blue #4A72FF) -->
                            <Border Grid.Column="0" Background="#111520" CornerRadius="12" Padding="10,12" Margin="0,0,4,0" BorderBrush="#252F48" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[0]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Channel Header -->
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconSpeaker}" Stroke="#4A72FF" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="MASTER" FontWeight="Bold" FontSize="12" Foreground="#4A72FF" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Device Pill -->
                                    <Border Grid.Row="1" Background="#0C0E14" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding AssignedDeviceName}" FontSize="10" Style="{StaticResource TextSubtle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- Vertical Fader & Stereo VU Meter -->
                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="160" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="160" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Volume Text -->
                                    <TextBlock Grid.Row="3" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />

                                    <!-- Mute Button -->
                                    <ToggleButton Grid.Row="4" Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <!-- Bottom Label -->
                                    <Border Grid.Row="5" Background="#161B26" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="MAIN OUT" FontSize="9" FontWeight="SemiBold" Foreground="#4A72FF" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 1: GAME (Emerald #10B981) -->
                            <Border Grid.Column="1" Background="#111520" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#1C382B" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[1]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="GAME" FontWeight="Bold" FontSize="12" Foreground="#10B981" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0C0E14" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding PresetName}" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="160" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="160" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <ToggleButton Grid.Row="4" Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <Border Grid.Row="5" Background="#13261D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="DIRECT AUDIO" FontSize="9" FontWeight="SemiBold" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 2: CHAT (Cyan #00B4D8) -->
                            <Border Grid.Column="2" Background="#111520" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#163442" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[2]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="CHAT" FontWeight="Bold" FontSize="12" Foreground="#00B4D8" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0C0E14" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                        <TextBlock Text="DISCORD / COMMS" FontSize="10" Foreground="#00B4D8" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="160" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="160" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <ToggleButton Grid.Row="4" Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <Border Grid.Row="5" Background="#102530" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="VOICE STREAM" FontSize="9" FontWeight="SemiBold" Foreground="#00B4D8" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 3: MEDIA (Pink #EC4899) -->
                            <Border Grid.Column="3" Background="#111520" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#3B1C2E" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[3]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconMediaPlay}" Fill="#EC4899" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="MEDIA" FontWeight="Bold" FontSize="12" Foreground="#EC4899" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0C0E14" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                        <TextBlock Text="SPOTIFY / MUSIC" FontSize="10" Foreground="#EC4899" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="160" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="160" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <ToggleButton Grid.Row="4" Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <Border Grid.Row="5" Background="#291420" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="MUSIC / BROWSER" FontSize="9" FontWeight="SemiBold" Foreground="#EC4899" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 4: AUX (Purple #A855F7) -->
                            <Border Grid.Column="4" Background="#111520" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#341E47" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[4]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconAuxWaves}" Stroke="#A855F7" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="AUX" FontWeight="Bold" FontSize="12" Foreground="#A855F7" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0C0E14" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                        <TextBlock Text="SYSTEM / APPS" FontSize="10" Foreground="#A855F7" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="160" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="160" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <ToggleButton Grid.Row="4" Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <Border Grid.Row="5" Background="#241530" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="AUXILIARY" FontSize="9" FontWeight="SemiBold" Foreground="#A855F7" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 5: MIC (Amber #F59E0B) -->
                            <Border Grid.Column="5" Background="#111520" CornerRadius="12" Padding="10,12" Margin="4,0,0,0" BorderBrush="#3D2910" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[5]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconMicrophone}" Stroke="#F59E0B" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="MIC" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Background="#0C0E14" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding AssignedDeviceName}" FontSize="10" Foreground="#F59E0B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{StaticResource SonarVerticalFader}" Height="160" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="1" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="160" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                                    <ToggleButton Grid.Row="4" Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,0,0,6" />

                                    <Border Grid.Row="5" Background="#2B1D0C" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="BROADCAST MIC" FontSize="9" FontWeight="SemiBold" Foreground="#F59E0B" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Per-App Volume & Routing Matrix -->
                <Border Style="{StaticResource GlassCard}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDevices}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="مصفوفة توجيه البرامج (App Volume &amp; Routing Matrix)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Real-time Windows Process Audio Streams" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AppRoutings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10131B" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Real Icon -->
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#181C26" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- App Name -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProcessName}" FontSize="10" Style="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Channel Destination Selector -->
                                            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableChannelNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding ChannelName, Mode=TwoWay}"
                                                          Foreground="{StaticResource AccentBrush}"
                                                          FontWeight="SemiBold"
                                                          FontSize="11"
                                                          BorderThickness="0"
                                                          Background="Transparent" />
                                            </Border>

                                            <!-- Slider -->
                                            <Slider Grid.Column="3" Style="{StaticResource NexusSlider}" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- Percentage -->
                                            <TextBlock Grid.Column="4" Text="{Binding Volume, StringFormat={}{0:0}%}" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />

                                            <!-- Active Checkbox Toggle -->
                                            <CheckBox Grid.Column="5" IsChecked="{Binding IsChannelRouted, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 2: GAME EQ & CHAT EQ (10-BAND PARAMETRIC EQUALIZER)                   -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Game EQ}">
                
                <!-- Presets & Spatial Audio Bar -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHeadphones}" Stroke="#10B981" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="بروفايلات الألعاب ومعالج الصوت (Game Presets &amp; Spatial Sound)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetEqBandsCommand}" Content="استعادة الترددات المسطحة (Flat)" HorizontalAlignment="Right" />
                        </Grid>

                        <WrapPanel Margin="0,0,0,14">
                            <ComboBox ItemsSource="{Binding EqualizerPresets}"
                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Width="240" Height="32"
                                      Padding="10,4"
                                      Margin="0,0,12,0"
                                      Background="#111520"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center" />

                            <Border Background="#111520" CornerRadius="8" Padding="14,6" Margin="0,0,12,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="صوت محيطي 360 Spatial Audio" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsSpatialAudioEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111520" CornerRadius="8" Padding="14,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Smart Volume (معزز الحوار)" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <CheckBox IsChecked="{Binding IsSmartVolumeEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Bass Boost Slider -->
                        <Grid Background="#0C0E14" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="مستوى تعزيز البيس (Bass Boost)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,16,0" />
                            <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding BassBoostAmount, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding BassBoostAmount, StringFormat={}{0:0}%}" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 10-Band Graphic Equalizer Faders -->
                <Border Style="{StaticResource GlassCard}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="المعادل الصوتي البارامتري (10-Band Precision Equalizer)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="-12 dB إلى +12 dB" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding EqualizerBands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                        <Slider Style="{StaticResource EqVerticalSlider}" Value="{Binding GainDb, Mode=TwoWay}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding FrequencyLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 3: CHAT EQ                                                            -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Chat EQ}">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="معالجة أصوات المحادثات والاتصال (Discord &amp; Voice Comms)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- ClearCast AI Noise Cancellation Card -->
                        <Border Background="#10141D" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#1C2838" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="عزل الضجيج الذكي ClearCast AI" FontWeight="Bold" Foreground="#00B4D8" FontSize="12" />
                                        <TextBlock Text=" (يقوم بإزالة أصوات الكيبورد والمراوح تماماً)" Style="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding IsClearCastAiEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="قوة العزل (Reduction Strength)" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding ClearCastStrength, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClearCastStrength, StringFormat={}{0:0}%}" Foreground="#00B4D8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Vocal Intelligibility Tuning -->
                        <Border Background="#10141D" CornerRadius="10" Padding="16" BorderBrush="#1C2838" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ضبط نبرة الصوت (Vocal Warmth &amp; Presence)" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="تم ضبط القناة مسبقاً لتضخيم ترددات 1kHz - 4kHz لمنح أصوات زملائك في الديسكورد أعلى درجات الوضوح أثناء احتدام المعارك." Style="{StaticResource TextSubtle}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- TAB 4: MIC STUDIO                                                         -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Mic Studio}">
                <Border Style="{StaticResource GlassCard}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMicrophone}" Stroke="#F59E0B" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="استوديو المايكروفون والبث (Broadcast Mic DSP Suite)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <Border Background="#251705" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right">
                                <TextBlock Text="Low-Latency DSP Active" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>

                        <!-- Mic Monitoring (Sidetone) -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="مراقبة المايك الفورية (Mic Monitoring / Sidetone)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="سماع صوتك في السماعة فورياً دون أي تأخير للتحكم بنبرتك" Style="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsMicMonitoringEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 1. Input Gain -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="حساسية المايك (Input Gain)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="-12 dB إلى +12 dB" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding MicGainDb, Mode=TwoWay}" Minimum="-12" Maximum="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding MicGainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. Noise Gate -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="بوابة الضجيج (Noise Gate Threshold)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="قطع الأصوات الأقل من هذا الحد" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding NoiseGateThresholdDb, Mode=TwoWay}" Minimum="-60" Maximum="-10" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding NoiseGateThresholdDb, StringFormat={}{0:0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 3. Compressor -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الضاغط الصوتي (Compressor Threshold)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="موازنة الأصوات المرتفعة والمنخفضة" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" Minimum="-30" Maximum="-5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CompressorThresholdDb, StringFormat={}{0:0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 4. Brickwall Limiter -->
                        <Border Background="#111520" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="سقف التحديد (Limiter Ceiling)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="منع تشويش الصوت عند الصراخ (Clipping)" Style="{StaticResource TextMuted}" FontSize="10" />
                                </StackPanel>
                                <Slider Grid.Column="1" Style="{StaticResource NexusSlider}" Value="{Binding LimiterCeilingDb, Mode=TwoWay}" Minimum="-6" Maximum="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding LimiterCeilingDb, StringFormat={}{0:0.0} dB}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
