<UserControl x:Class="Nexus.App.Views.AudioStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrl="clr-namespace:Nexus.App.Controls"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:AudioStudioViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Tab RadioButton Style -->
        <Style x:Key="SonarNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AccentGlowBrush}" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EQ Band Vertical Slider Style -->
        <Style x:Key="EqVerticalSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Border Width="4" CornerRadius="2" Background="#0A0B0F" BorderBrush="#1C1F2B" BorderThickness="1" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="10" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="2" Background="{StaticResource AccentBrush}" BorderBrush="#FFFFFF" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header & Navigation Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Ecosystem Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="12,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="SONAR AUDIO STUDIO" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Studio Tabs (Mixer | Game | Chat | Media | Aux | Mic) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الميكسر (Mixer)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mixer}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Mixer" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الألعاب (Game)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Game}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Game" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="المحادثة (Chat)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Chat}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Chat" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الوسائط (Media)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Media}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Media" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="الإضافي (Aux)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Aux}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Aux" />
                        <RadioButton Style="{StaticResource SonarNavTabStyle}" Content="المايك (Mic)"
                                     IsChecked="{Binding SelectedTopTab, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Mic}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="Mic" />
                    </StackPanel>

                    <!-- Quick Global Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding PopoutMixerCommand}" Margin="0,0,6,0" Padding="8,4" ToolTip="فتح الميكسر في نافذة منبثقة مستقلة">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPopout}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="نافذة منبثقة (Pop-out)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding MuteAllChannelsCommand}" Margin="0,0,6,0" Padding="8,4" Content="كتم الكل" FontSize="11" />
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetAllVolumesCommand}" Margin="0,0,6,0" Padding="8,4" Content="إعادة ضبط" FontSize="11" />
                        <Button Style="{StaticResource NexusAccentButton}" Command="{Binding RefreshSessionsCommand}" Height="28" Padding="10,3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="تحديث" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- TAB 1: MIXER (MAIN 6-CHANNEL RACK + CHATMIX + ROUTING)                    -->
            <!-- ========================================================================= -->
            <StackPanel Visibility="{Binding SelectedTopTab, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Mixer}">

                <!-- 6-Channel Mixer Rack -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAudio}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="قنوات الصوت الاحترافية (Independent Audio Sources &amp; Faders)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource NexusPillButton}" Command="{Binding PopoutMixerCommand}" Margin="0,0,10,0" Padding="8,3" ToolTip="فصل الميكسر في نافذة عائمة">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPopout}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="نافذة منبثقة" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Background="#10B981" Width="6" Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SteelSeries Sonar Matrix Engine Active" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 6-Columns Channel Strips Grid with Integrated Sonar ChatMix -->
                        <Grid MinHeight="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Channel 0: MASTER (Cobalt Blue #3B82F6) -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#0F131D" CornerRadius="12" Padding="10,12" Margin="0,0,4,0" BorderBrush="#253556" BorderThickness="1">
                                <Grid DataContext="{Binding Channels[0]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Channel Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconSpeaker}" Stroke="#3B82F6" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="MASTER" FontWeight="Bold" FontSize="12" Foreground="#3B82F6" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Spacer to align with preset row -->
                                    <Border Grid.Row="1" Height="24" Margin="0,0,0,6" />

                                    <!-- Independent Audio Device Dropdown -->
                                    <Border Grid.Row="2" Margin="0,0,0,8">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="اختر مخرج الصوت المخصص لقناة الماستر" />
                                    </Border>

                                    <!-- Vertical Fader, dB Scale & Stereo VU Meter -->
                                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Volume Text & Decibels Display -->
                                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,6">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Dual Hardware Buttons: Mute (M) & Solo (S) -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="كتم القناة (Mute)" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="عزل القناة (Solo)" />
                                    </StackPanel>

                                    <!-- Apps to be routed Box -->
                                    <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="6" MinHeight="110" MaxHeight="130" BorderBrush="#1E293B" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconAudio}" Stroke="#3B82F6" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                            <TextBlock Text="Apps to be routed" FontWeight="Bold" FontSize="10" Foreground="#3B82F6" HorizontalAlignment="Center" />
                                            <TextBlock Text="MAIN MIX OUT" FontSize="8" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 1: GAME (Emerald #10B981) -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#0F1517" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#1C382B" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Game Channel">
                                <Grid DataContext="{Binding Channels[1]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="GAME" FontWeight="Bold" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Preset Pill -->
                                    <Border Grid.Row="1" Background="#11241C" CornerRadius="6" Padding="8,3" Margin="0,0,0,6" HorizontalAlignment="Center" BorderBrush="#10B981" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PresetName}" FontSize="9" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Margin="0,0,0,8">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="اختر مخرج الصوت المخصص لقناة الألعاب" />
                                    </Border>

                                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,6">
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DecibelsDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,6,0" ToolTip="كتم القناة (Mute)" />
                                        <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="عزل القناة (Solo)" />
                                    </StackPanel>

                                    <!-- Apps Container Box with Drag & Drop -->
                                    <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="6" MinHeight="110" MaxHeight="130"
                                            BorderBrush="#1C382B" BorderThickness="1"
                                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Game Channel">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Apps" FontSize="9" FontWeight="SemiBold" Foreground="#10B981" Margin="2,0,0,4" />
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding AssignedApps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="5" Padding="5,3" Margin="0,0,0,3"
                                                                    Background="#10251C" BorderBrush="{Binding PillColorHex}" BorderThickness="1"
                                                                    ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                                    PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                                    MouseMove="AppIcon_MouseMove"
                                                                    MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayNameUpper}"
                                                                               FontWeight="Bold" FontSize="9" Foreground="#F1F5F9"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Channel 2: CHAT (Electric Cyan #00B4D8) -->
                            <Border Grid.Row="0" Grid.Column="2" Background="#0C141A" CornerRadius="12" Padding="10,12" Margin="3,0,3,0" BorderBrush="#163442" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Chat Channel">
                                <Grid DataContext="{Binding Channels[2]}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CHAT" FontWeight="Bold" FontSize="12" Foreground="#00B4D8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Preset Pill -->
                                    <Border Grid.Row="1" Background="#0E212B" CornerRadius="6" Padding="8,3" Margin="0,0,0,6" HorizontalAlignment="Center" BorderBrush="#00B4D8" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#00B4D8" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PresetName}" FontSize="9" FontWeight="Bold" Foreground="#22D3EE" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Margin="0,0,0,8">
                                        <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                                  ItemsSource="{Binding AvailableDevices}"
                                                  SelectedItem="{Binding SelectedDevice}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="اختر مخرج الصوت المخصص لقناة المحادثة" />
                                    </Border>

                                    <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <UniformGrid Grid.Column="0" Rows="7" Height="170" Margin="0,0,4,0">
                                            <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </UniformGrid>

                                        <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Height="170" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,6,0" />
                                        <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="12" Height="170" VerticalAlignment="Center" />
                                    </Grid>

