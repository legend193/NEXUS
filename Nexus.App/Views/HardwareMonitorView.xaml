<UserControl x:Class="Nexus.App.Views.HardwareMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrls="clr-namespace:Nexus.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:HardwareMonitorViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="HARDWARE MONITOR" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Real-Time 1000Hz Telemetry Streaming Active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh Telemetry" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Layout: 4 Multi-Tier Graphs (Left 65%) & Sensors / Top Processes (Right 35%) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: 4 Multi-Tier Hardware Telemetry Graphs -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconActivity}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Telemetry Streams" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Hardware Sensors Direct Read" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Tier 1: CPU Telemetry Graph -->
                        <Border Background="#0E1119" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CPU Load &amp; Activity" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Ryzen 9 5900X" Style="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LatestCpuUsage, StringFormat={}{0:0.0}%}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding LatestCpuTemp, StringFormat={}{0:0}°C}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <ctrls:SparklineGraph Points="{Binding CpuHistory}" Height="60" LineBrush="{StaticResource AccentBrush}" StrokeThickness="2" Minimum="0" Maximum="100" />
                            </StackPanel>
                        </Border>

                        <!-- Tier 2: GPU Telemetry Graph -->
                        <Border Background="#0E1119" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GPU Core &amp; VRAM" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="MSI GeForce RTX 3080" Style="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LatestGpuUsage, StringFormat={}{0:0.0}%}" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding LatestGpuTemp, StringFormat={}{0:0}°C}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <ctrls:SparklineGraph Points="{Binding GpuHistory}" Height="60" LineBrush="{StaticResource EmeraldGreenBrush}" StrokeThickness="2" Minimum="0" Maximum="100" />
                            </StackPanel>
                        </Border>

                        <!-- Tier 3: Motherboard & Memory Telemetry Graph -->
                        <Border Background="#0E1119" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Motherboard &amp; Memory" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="X570S AORUS + Corsair 32GB" Style="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LatestRamUsage, StringFormat={}{0:0.0}%}" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                                <ctrls:SparklineGraph Points="{Binding RamHistory}" Height="60" LineBrush="{StaticResource AccentPurpleBrush}" StrokeThickness="2" Minimum="0" Maximum="100" />
                            </StackPanel>
                        </Border>

                        <!-- Tier 4: Total Power Draw Watts Graph -->
                        <Border Background="#0E1119" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Power Draw" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Combined System Watts" Style="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TotalPowerWatts, StringFormat={}{0:0} W}" FontWeight="Bold" Foreground="{StaticResource AmberGoldBrush}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                                <ctrls:SparklineGraph Points="{Binding PowerHistory}" Height="60" LineBrush="{StaticResource AmberGoldBrush}" StrokeThickness="2" Minimum="50" Maximum="600" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Column: Sensors Fan Cluster & Top Consuming Processes -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    
                    <!-- Fan Cluster RPM Subcard -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCooling}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Sensors &amp; Fans" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="RPM Telemetry" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>

                            <Border Background="#0E1119" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFanBlade}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="CPU Cooler Fan" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FanCpuRpm, StringFormat={}{0} RPM}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#0E1119" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFanBlade}" Stroke="{StaticResource EmeraldGreenBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="GPU Active Fans" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FanGpuRpm, StringFormat={}{0} RPM}" FontWeight="Bold" Foreground="{StaticResource EmeraldGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#0E1119" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconFanBlade}" Stroke="{StaticResource SonarOrangeBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="Case Intake &amp; Exhaust" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FanCaseRpm, StringFormat={}{0} RPM}" FontWeight="Bold" Foreground="{StaticResource SonarOrangeBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Top Consuming Processes Subcard -->
                    <Border Style="{StaticResource GlassCard}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconZap}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="High Resource Processes" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Live Task Usage" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding TopProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0E1119" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Background="{StaticResource AccentGlowBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CpuUsage}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding RamUsage}" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
