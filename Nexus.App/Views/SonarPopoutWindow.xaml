<Window x:Class="Nexus.App.Views.SonarPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nexus.App.ViewModels"
        xmlns:ctrl="clr-namespace:Nexus.App.Controls"
        xmlns:conv="clr-namespace:Nexus.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AudioStudioViewModel}"
        Title="NEXUS Sonar Audio Mixer"
        Height="730" Width="1100"
        MinHeight="580" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsPopoutAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <!-- Outer Deep Dark Cyber Card Border with Ambient Glow -->
    <Border Background="#F40B0E15"
            BorderBrush="#2A3C59"
            BorderThickness="1.5"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#00D2FF" Opacity="0.18" />
        </Border.Effect>

        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: WINDOW DRAGGABLE HEADER & CONTROLS                                 -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Branding & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00D2FF" Width="9" Height="9" CornerRadius="4.5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00D2FF" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="SONAR AUDIO MIXER" FontWeight="Bold" FontSize="13" Foreground="#00D2FF" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <!-- Floating Pill Badge -->
                    <Border Background="#14233D" CornerRadius="5" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Floating Mixer" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" />
                    </Border>

                    <!-- Realtime Engine Sync Badge -->
                    <Border Background="#11241C" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Realtime Sync (0ms)" FontSize="9" FontWeight="Bold" Foreground="#34D399" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Window Control Actions (Pin / Minimize / Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Always-On-Top Pin Toggle Button -->
                    <Button Style="{StaticResource NexusPillButton}"
                            Command="{Binding ToggleAlwaysOnTopCommand}"
                            Height="26" Padding="10,2" Margin="0,0,10,0"
                            ToolTip="Pin window always on top">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPin}" Stroke="#00D2FF" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Always On Top" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Minimize Window Button -->
                    <Button Style="{StaticResource WindowCloseButton}" Click="BtnMinimize_Click" Width="26" Height="26" Margin="0,0,4,0" ToolTip="Minimize">
                        <Path Data="{StaticResource IconMinimize}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="2" Stretch="Uniform" />
                    </Button>

                    <!-- Close Window Button -->
                    <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" Width="26" Height="26" ToolTip="Close">
                        <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 1: 6-CHANNEL MIXER RACK WITH INTEGRATED CHATMIX                       -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ================================================================= -->
                    <!-- Channel 0: MASTER (Cobalt Blue #3B82F6)                           -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="8,10" Margin="0,0,3,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid DataContext="{Binding Channels[0]}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Channel Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconSpeaker}" Stroke="#3B82F6" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MASTER" FontWeight="Bold" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Device Dropdown -->
                            <Border Grid.Row="1" Margin="0,0,0,5">
                                <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Master Output Device" />
                            </Border>

                            <!-- Tag Badge -->
                            <Border Grid.Row="2" Background="#162238" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EndpointStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="#60A5FA" />
                            </Border>

                            <!-- Fader, dB Labels & VU Meter -->
                            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="7" Height="140" Margin="0,0,3,0">
                                    <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </UniformGrid>

                                <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#00D2FF" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,5,0" />
                                <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="11" Height="140" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Volume Readout -->
                            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,5">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DecibelsDisplay}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Mute & Solo Buttons -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,5,0" ToolTip="Mute Channel" />
                                <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                            </StackPanel>

                            <!-- Bottom Tag -->
                            <Border Grid.Row="6" Background="#162033" CornerRadius="5" Padding="5,3">
                                <TextBlock Text="MAIN OUT" FontSize="8" FontWeight="SemiBold" Foreground="#3B82F6" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- Channel 1: GAME (Emerald #10B981)                                 -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="8,10" Margin="2,0,2,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Game Channel">
                        <Grid DataContext="{Binding Channels[1]}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="GAME" FontWeight="Bold" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,0,0,5">
                                <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Game Audio Endpoint" />
                            </Border>

                            <Border Grid.Row="2" Background="#132B20" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EndpointStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="#34D399" />
                            </Border>

                            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="7" Height="140" Margin="0,0,3,0">
                                    <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </UniformGrid>

                                <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#10B981" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,5,0" />
                                <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="11" Height="140" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,5">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DecibelsDisplay}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,5,0" ToolTip="Mute Channel" />
                                <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                            </StackPanel>

                            <!-- Apps Container Box with Drag & Drop -->
                            <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="5" MinHeight="95" MaxHeight="115"
                                    BorderBrush="#1C382B" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Game Channel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Apps" FontSize="9" FontWeight="SemiBold" Foreground="#10B981" Margin="2,0,0,3" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AssignedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4,2" Margin="0,0,0,3"
                                                            Background="#0D1F18" BorderBrush="{Binding PillColorHex}" BorderThickness="1"
                                                            ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                            MouseMove="AppIcon_MouseMove"
                                                            MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayNameUpper}"
                                                                       FontWeight="Bold" FontSize="8.5" Foreground="#F1F5F9"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- Channel 2: CHAT (Electric Cyan #00B4D8)                           -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="8,10" Margin="2,0,2,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Chat Channel">
                        <Grid DataContext="{Binding Channels[2]}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="CHAT" FontWeight="Bold" FontSize="11" Foreground="#00B4D8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,0,0,5">
                                <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Chat Audio Endpoint (Discord / Teams)" />
                            </Border>

                            <Border Grid.Row="2" Background="#102530" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EndpointStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="#22D3EE" />
                            </Border>

                            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="7" Height="140" Margin="0,0,3,0">
                                    <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </UniformGrid>

                                <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#00B4D8" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,5,0" />
                                <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="11" Height="140" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,5">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DecibelsDisplay}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,5,0" ToolTip="Mute Channel" />
                                <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                            </StackPanel>

                            <!-- Apps Container Box with Drag & Drop -->
                            <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="5" MinHeight="95" MaxHeight="115"
                                    BorderBrush="#163442" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Chat Channel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Apps" FontSize="9" FontWeight="SemiBold" Foreground="#00B4D8" Margin="2,0,0,3" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AssignedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4,2" Margin="0,0,0,3"
                                                            Background="#0D212B" BorderBrush="{Binding PillColorHex}" BorderThickness="1"
                                                            ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                            MouseMove="AppIcon_MouseMove"
                                                            MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayNameUpper}"
                                                                       FontWeight="Bold" FontSize="8.5" Foreground="#F1F5F9"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- Channel 3: MEDIA (Neon Pink #EC4899)                              -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="8,10" Margin="2,0,2,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Media Channel">
                        <Grid DataContext="{Binding Channels[3]}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconMediaPlay}" Fill="#EC4899" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MEDIA" FontWeight="Bold" FontSize="11" Foreground="#EC4899" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,0,0,5">
                                <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Media Audio Endpoint (Spotify / YouTube)" />
                            </Border>

                            <Border Grid.Row="2" Background="#2B1422" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EndpointStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="#F472B6" />
                            </Border>

                            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="7" Height="140" Margin="0,0,3,0">
                                    <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </UniformGrid>

                                <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#E11D48" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,5,0" />
                                <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="11" Height="140" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,5">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DecibelsDisplay}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,5,0" ToolTip="Mute Channel" />
                                <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                            </StackPanel>

                            <!-- Apps Container Box with Drag & Drop -->
                            <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="5" MinHeight="95" MaxHeight="115"
                                    BorderBrush="#3B1C2E" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Media Channel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Apps" FontSize="9" FontWeight="SemiBold" Foreground="#EC4899" Margin="2,0,0,3" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AssignedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4,2" Margin="0,0,0,3"
                                                            Background="#241221" BorderBrush="{Binding PillColorHex}" BorderThickness="1"
                                                            ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                            MouseMove="AppIcon_MouseMove"
                                                            MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayNameUpper}"
                                                                       FontWeight="Bold" FontSize="8.5" Foreground="#F1F5F9"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- Channel 4: AUX (Studio Purple #A855F7)                            -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="8,10" Margin="2,0,2,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Aux Channel">
                        <Grid DataContext="{Binding Channels[4]}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconAuxWaves}" Stroke="#A855F7" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="AUX" FontWeight="Bold" FontSize="11" Foreground="#A855F7" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,0,0,5">
                                <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Aux Audio Endpoint" />
                            </Border>

                            <Border Grid.Row="2" Background="#261536" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EndpointStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="#C084FC" />
                            </Border>

                            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="7" Height="140" Margin="0,0,3,0">
                                    <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </UniformGrid>

                                <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#A855F7" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,5,0" />
                                <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="11" Height="140" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,5">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DecibelsDisplay}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,5,0" ToolTip="Mute Channel" />
                                <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                            </StackPanel>

                            <!-- Apps Container Box with Drag & Drop -->
                            <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="5" MinHeight="95" MaxHeight="115"
                                    BorderBrush="#341E47" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Aux Channel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Apps" FontSize="9" FontWeight="SemiBold" Foreground="#A855F7" Margin="2,0,0,3" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AssignedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4,2" Margin="0,0,0,3"
                                                            Background="#221230" BorderBrush="{Binding PillColorHex}" BorderThickness="1"
                                                            ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                            MouseMove="AppIcon_MouseMove"
                                                            MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayNameUpper}"
                                                                       FontWeight="Bold" FontSize="8.5" Foreground="#F1F5F9"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- Channel 5: MIC (Amber Gold #F59E0B)                               -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="0" Grid.Column="5" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="8,10" Margin="3,0,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Mic Channel">
                        <Grid DataContext="{Binding Channels[5]}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconMicrophone}" Stroke="#F59E0B" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MIC" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,0,0,5">
                                <ComboBox Style="{StaticResource SonarDeviceComboBox}"
                                          ItemsSource="{Binding AvailableDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Microphone Input Device" />
                            </Border>

                            <Border Grid.Row="2" Background="#2D1E0C" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EndpointStatusText}" FontSize="8" FontWeight="SemiBold" Foreground="#FBBF24" />
                            </Border>

                            <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="7" Height="140" Margin="0,0,3,0">
                                    <TextBlock Text="+3" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="0" FontSize="8" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-6" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-12" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-24" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-40" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Text="-inf" FontSize="8" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </UniformGrid>

                                <Slider Grid.Column="1" Style="{StaticResource SonarVerticalFader}" Foreground="#F59E0B" Height="140" Value="{Binding Volume}" Minimum="0" Maximum="100" Margin="0,0,5,0" />
                                <ctrl:StereoVuMeter Grid.Column="2" LevelLeft="{Binding PeakLevelLeft}" LevelRight="{Binding PeakLevelRight}" Width="11" Height="140" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,3,0,5">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DecibelsDisplay}" FontSize="8" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <ToggleButton Style="{StaticResource SonarMuteButton}" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,5,0" ToolTip="Mute Microphone" />
                                <ToggleButton Style="{StaticResource SonarSoloButton}" IsChecked="{Binding IsSolo, Mode=TwoWay}" ToolTip="Solo Channel" />
                            </StackPanel>

                            <!-- Apps Container Box with Drag & Drop -->
                            <Border Grid.Row="6" Background="#0A0E17" CornerRadius="8" Padding="5" MinHeight="95" MaxHeight="115"
                                    BorderBrush="#3D2910" BorderThickness="1"
                                    AllowDrop="True" Drop="ChannelTray_Drop" DragOver="ChannelTray_DragOver" Tag="Mic Channel">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Apps" FontSize="9" FontWeight="SemiBold" Foreground="#F59E0B" Margin="2,0,0,3" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AssignedApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4,2" Margin="0,0,0,3"
                                                            Background="#23170B" BorderBrush="{Binding PillColorHex}" BorderThickness="1"
                                                            ToolTip="{Binding DisplayName}" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                                            MouseMove="AppIcon_MouseMove"
                                                            MouseRightButtonUp="AppIcon_MouseRightButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayNameUpper}"
                                                                       FontWeight="Bold" FontSize="8.5" Foreground="#F1F5F9"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ================================================================= -->
                    <!-- COMPACT CHATMIX (Directly under Column 1 GAME & Column 2 CHAT)     -->
                    <!-- ================================================================= -->
                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10,6" Margin="2,8,2,0"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1.2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CHATMIX" FontWeight="Bold" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,3" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0" Data="{StaticResource IconGameController}" Stroke="#10B981" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Slider Grid.Row="0" Style="{StaticResource SonarChatMixSlider}"
                                            Value="{Binding ChatMixSliderValue, Mode=TwoWay}"
                                            Minimum="-100" Maximum="100" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="{Binding ChatMixBalanceText}" FontSize="8" FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                </Grid>

                                <Path Grid.Column="2" Data="{StaticResource IconChatBubble}" Stroke="#00B4D8" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- ROW 2: FOOTER BAR & QUICK CONTROLS                                        -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="NEXUS SteelSeries Sonar Engine • Ultra-Low Latency Synchronized Audio Streams" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NexusPillButton}" Command="{Binding MuteAllChannelsCommand}" Margin="0,0,6,0" Padding="10,4" Content="Mute All" FontSize="11" />
                    <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetAllVolumesCommand}" Margin="0,0,6,0" Padding="10,4" Content="Reset" FontSize="11" />
                    <Button Style="{StaticResource NexusAccentButton}" Command="{Binding RefreshSessionsCommand}" Height="28" Padding="12,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sync" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
