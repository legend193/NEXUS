<UserControl x:Class="Nexus.App.Views.RgbStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:ctrls="clr-namespace:Nexus.App.Controls"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RgbStudioViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- RGB Studio Top Header Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="RGB STUDIO" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HardwareStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding AutoScanDevicesCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Auto-Scan" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NexusAccentButton}" Command="{Binding SyncAllHardwareCommand}" Height="32" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconZap}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sync Hardware" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Layout: Rig Canvas (Left 62%) & Lighting Controls (Right 38%) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Interactive PC Rig & Sliders -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    
                    <!-- Interactive PC Rig Canvas Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRgb}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="PC Rig Canvas — Lian Li O11 EVO" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <!-- Viewport Controls: LCD Screen Customizer & 3D/2D Mode Toggle -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- AIO LCD Screen Customizer Button -->
                                    <Button Command="{Binding OpenLcdCustomizerCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,10,0">
                                        <Border Background="#162032" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="#00D2FF" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" Color="#00D2FF" Opacity="0.8" ShadowDepth="0" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="تخصيص شاشة المبرد LCD" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- 3D/2D Viewport Mode Toggle Button -->
                                    <Button Command="{Binding ToggleViewportModeCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="التبديل بين التجميعة الكاملة ثلاثية الأبعاد والمكونات المفصولة">
                                        <Border Background="#161B26" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ViewportModeBadge}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text=" (تبديل ⟳)" Style="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Rig Visual Frame: Centered & Spacious Interactive Viewport (3D Assembled Rig & 2D Separated Components) -->
                            <Border Background="#0D1018" CornerRadius="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="530" Padding="6">
                                <Border x:Name="WebViewHostBorder"
                                        CornerRadius="10" Background="#111520" ClipToBounds="True" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lighting Effects & Sliders Card -->
                    <Border Style="{StaticResource GlassCard}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Effects Picker -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Lighting effects" Style="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <Button Content="Static" Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Static" Margin="0,0,4,6" Height="32" />
                                    <Button Content="Rainbow" Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Rainbow" Margin="4,0,0,6" Height="32" />
                                    <Button Content="Wave" Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Wave" Margin="0,0,4,6" Height="32" />
                                    <Button Content="Breathing" Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Breathing" Margin="4,0,0,6" Height="32" />
                                    <Button Content="Color Cycle" Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Color Cycle" Margin="0,0,4,0" Height="32" />
                                    <Button Content="Audio Sync" Style="{StaticResource NexusPillButton}" Command="{Binding SelectEffectCommand}" CommandParameter="Audio Sync" Margin="4,0,0,0" Height="32" />
                                </UniformGrid>
                            </StackPanel>

                            <!-- Right: Speed & Brightness Sliders -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Speed / Brightness" Style="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10" />

                                <!-- Speed Slider -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Speed" Style="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0}x}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Value="{Binding Speed}" Minimum="0.1" Maximum="3.0" SmallChange="0.1" Margin="0,0,0,14" />

                                <!-- Brightness Slider -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Brightness" Style="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock Text="{Binding Brightness, StringFormat={}{0:0}%}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Value="{Binding Brightness}" Minimum="0" Maximum="100" Margin="0,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- Right Column: Color Wheel & Palette & Master Sync Toggle -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,0,0" Padding="18">
                    <StackPanel>
                        
                        <!-- Header with Target Component Selector -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Lighting" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            
                            <!-- Target Zone ComboBox -->
                            <ComboBox ItemsSource="{Binding AvailableTargetZones}"
                                      SelectedItem="{Binding SelectedTargetZone}"
                                      Width="160" Height="30" HorizontalAlignment="Right"
                                      Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderSubtleBrush}" FontSize="11" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14" />

                        <!-- Circular Color Wheel Control -->
                        <Grid HorizontalAlignment="Center" Margin="0,4,0,14">
                            <ctrls:ColorWheelControl SelectedColorHex="{Binding PrimaryColorHex, Mode=TwoWay}"
                                                     Width="160" Height="160" />
                        </Grid>

                        <!-- Selected Color Hex & Indicators -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding PrimaryColorHex}" Margin="0,0,8,0" BorderBrush="#FFFFFF" BorderThickness="1" />
                                    <TextBlock Text="Active Hex:" Style="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding PrimaryColorHex}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Apply" Style="{StaticResource NexusPillButton}" Command="{Binding SyncAllHardwareCommand}" HorizontalAlignment="Right" Height="24" Padding="10,0" FontSize="10" />
                            </Grid>
                        </Border>

                        <!-- Custom Colors: 16 Swatches Grid (2 rows x 8 columns) -->
                        <TextBlock Text="Custom colors" Style="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ApplyPresetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding HexColor}"
                                            ToolTip="{Binding Name}"
                                            Margin="3" Width="28" Height="28" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="swatchCircle" Width="22" Height="22"
                                                             Fill="{Binding Brush}"
                                                             Stroke="#2D3748" StrokeThickness="1.5" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="swatchCircle" Property="Stroke" Value="#FFFFFF" />
                                                        <Setter TargetName="swatchCircle" Property="StrokeThickness" Value="2.5" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="swatchCircle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="swatchCircle" Property="StrokeThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom: Master Sync All Devices Toggle Switch -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sync All Devices" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Broadcast RGB frame to all 7 devices" Style="{StaticResource TextSubtle}" FontSize="10" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding IsSyncAllDevices, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource NexusToggleSwitch}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>

    <!-- AIO LCD Customizer Modal Dialog Overlay -->
    <Grid Background="#B3060910"
          Visibility="{Binding IsLcdCustomizerOpen, Converter={StaticResource BoolToVisConverter}}"
          Panel.ZIndex="1000">
        <Border Width="820" MaxHeight="640"
                Background="#101522"
                CornerRadius="16"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1.5"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Color="#00D2FF" Opacity="0.35" ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="مركز تخصيص شاشة المبرد المائي • Corsair iCUE ELITE LCD"
                                       FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="شاشة IPS دائرية 480x480 • حلقة هالة محيطية 24-LED RGB • مزامنة فورية مع درجات الحرارة"
                                   Style="{StaticResource TextSubtle}" FontSize="11" Margin="18,3,0,0" />
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Command="{Binding CloseLcdCustomizerCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand">
                        <Border Background="#1E2638" CornerRadius="8" Padding="12,5" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <TextBlock Text="إغلاق" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </Border>
                    </Button>
                </Grid>

                <!-- Body: 2 Columns (Preview on Left, Controls on Right) -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Circular Screen Live Bezel Preview -->
                    <Border Grid.Column="0" Background="#0A0E17" CornerRadius="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="16" Margin="0,0,16,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Bezel Frame (220x220) with Dynamic Halo Glow -->
                            <Border Width="220" Height="220" CornerRadius="110"
                                    Background="#060910"
                                    BorderBrush="{Binding LcdHaloRingColorHex}"
                                    BorderThickness="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="25" Color="{Binding LcdHaloRingColorHex}" Opacity="0.45" ShadowDepth="0" />
                                </Border.Effect>
                                
                                <!-- Inner Display Screen (174x174) -->
                                <Border Width="174" Height="174" CornerRadius="87"
                                        Background="#0C1322"
                                        BorderBrush="#1E293B"
                                        BorderThickness="2">
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Circular Gauge Track -->
                                        <Ellipse Width="150" Height="150" Stroke="#131F33" StrokeThickness="8" />
                                        <Ellipse Width="150" Height="150" Stroke="{Binding LcdDialAccentColorHex}" StrokeThickness="8" StrokeDashArray="6 2" Opacity="0.85" />

                                        <!-- Mode Content Preview -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedLcdModeTitle}" FontWeight="SemiBold" FontSize="9" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding LcdPreviewPrimaryText}" FontWeight="Black" FontSize="38" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding LcdPreviewUnitText}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="2,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LcdPreviewSubtitleText}" Style="{StaticResource TextSubtle}" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            <TextBlock Text="CORSAIR ELITE LCD" FontWeight="Bold" FontSize="8" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Live Telemetry Sensors Row -->
                            <Border Background="#111726" CornerRadius="8" Padding="10,6" Margin="0,14,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="CPU" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentCpuTemp, StringFormat='{}{0}°C'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="GPU" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentGpuTemp, StringFormat='{}{0}°C'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Coolant" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentCoolantTemp, StringFormat='{}{0}°C'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Hardware Status Pill -->
                            <Border Background="#141C2B" CornerRadius="6" Padding="10,5" Margin="0,8,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding LcdStatusMessage}" Style="{StaticResource TextSubtle}" FontSize="10" TextAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Mode Selection, Colors, Brightness -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Mode Selector -->
                            <TextBlock Text="أنماط عرض الشاشة (Screen Display Modes)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AvailableLcdModes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectLcdModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Mode}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,8,8">
                                            <Border x:Name="modeCardBorder" CornerRadius="8" Padding="12,8" BorderThickness="1.5" Width="185">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#161E2E" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1C273C" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource TextSubtle}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="160" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                             Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom Image / GIF Selector Button -->
                            <Button Command="{Binding BrowseCustomImageCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,4,0,12">
                                <Border Background="#1C2438" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCpuChip}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="اختيار صورة مخصصة أو ملف GIF من الجهاز..." FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding CustomImagePath}" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Halo Ring Presets -->
                            <TextBlock Text="لون حلقة الهالة المحيطية (24-LED Halo Ring)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,6" />
                            <ItemsControl ItemsSource="{Binding LcdColorPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyHaloRingPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding HexColor}"
                                                ToolTip="{Binding Name}"
                                                Margin="0,0,8,0" Width="28" Height="28" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Ellipse x:Name="haloCircle" Width="22" Height="22"
                                                                 Fill="{Binding Brush}"
                                                                 Stroke="#2D3748" StrokeThickness="1.5" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="haloCircle" Property="Stroke" Value="#FFFFFF" />
                                                            <Setter TargetName="haloCircle" Property="StrokeThickness" Value="2.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Brightness Slider with Live Percentage -->
                            <Grid Margin="0,14,0,4">
                                <TextBlock Text="سطوع الشاشة" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding LcdBrightness, StringFormat='{}{0:F0}%'}" Style="{StaticResource TextSubtle}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="10" Maximum="100" Value="{Binding LcdBrightness, Mode=TwoWay}"
                                    Style="{StaticResource NexusSlider}" Margin="0,0,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Actions -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseLcdCustomizerCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,10,0">
                            <Border Background="#182030" CornerRadius="8" Padding="16,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="إلغاء" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Button>

                        <Button Command="{Binding ApplyLcdSettingsCommand}"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="20,8">
                                <TextBlock Text="تطبيق وحفظ على المبرد (Apply to AIO LCD)" FontWeight="Bold" FontSize="12" Foreground="#0A0E17" />
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Grid>
</UserControl>
