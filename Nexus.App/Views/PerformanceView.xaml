<UserControl x:Class="Nexus.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:PerformanceViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="PERFORMANCE &amp; PROFILES" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Hardware Dynamic Overclocking &amp; Power Targets" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetDefaultsCommand}" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Reset Tuning Defaults" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 08 — TOP ROW: 4 MODE CARDS (Gaming, Silent, Productivity, Night) -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <!-- Mode 1: Gaming -->
                <Button Command="{Binding SelectModeCommand}" CommandParameter="Gaming" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,6,0">
                    <Border Style="{StaticResource GlassCard}" Padding="16,14" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Gaming" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Max Power &amp; Airflow" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,0,12" />
                            <Grid Grid.Row="2">
                                <Path Data="{StaticResource IconGameController}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsGamingActive, Mode=OneWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Button>

                <!-- Mode 2: Silent -->
                <Button Command="{Binding SelectModeCommand}" CommandParameter="Silent" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="3,0,3,0">
                    <Border Style="{StaticResource GlassCard}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Silent" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Acoustics Optimized" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,0,12" />
                            <Grid Grid.Row="2">
                                <Path Data="{StaticResource IconSnowSilent}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsSilentActive, Mode=OneWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Button>

                <!-- Mode 3: Productivity -->
                <Button Command="{Binding SelectModeCommand}" CommandParameter="Productivity" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="3,0,3,0">
                    <Border Style="{StaticResource GlassCard}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Productivity" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Balanced Workloads" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,0,12" />
                            <Grid Grid.Row="2">
                                <Path Data="{StaticResource IconPerformance}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsProductivityActive, Mode=OneWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Button>

                <!-- Mode 4: Night -->
                <Button Command="{Binding SelectModeCommand}" CommandParameter="Night" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="6,0,0,0">
                    <Border Style="{StaticResource GlassCard}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Night" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="Dimmed / RGB Off" Style="{StaticResource TextSubtle}" FontSize="11" Margin="0,0,0,12" />
                            <Grid Grid.Row="2">
                                <Path Data="{StaticResource IconMoon}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsNightActive, Mode=OneWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>
                </Button>
            </UniformGrid>

            <!-- 08 — BOTTOM ROW: GROUPED CONTROLS (Left) & SUSTAINED TUNING SLIDERS (Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Grouped Profile Settings -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Grouped Settings" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Quick Toggle" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Group 1: RGB -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRgb}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="RGB Lighting Profile" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsRgbGroupEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Group 2: Audio -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconAudio}" Stroke="{StaticResource EmeraldGreenBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Audio Sonar EQ Preset" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsAudioGroupEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Group 3: Fans -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCooling}" Stroke="{StaticResource SonarOrangeBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Fan &amp; Pump Curve" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsFanGroupEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Group 4: Performance -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPerformance}" Stroke="{StaticResource AccentPurpleBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="Power &amp; Thermal Limits" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsLimitsGroupEnabled, Mode=TwoWay}" Style="{StaticResource NexusToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Sustained Hardware Tuning Sliders -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,0,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Sustained Tuning" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="GPU &amp; VBIOS Safeguards Active" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Clock Speed (MHz) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Core Clock Target" Style="{StaticResource TextSecondary}" FontSize="11" />
                            <TextBlock Text="{Binding CoreClockOffsetMhz, StringFormat={}+{0} MHz}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="{Binding CoreClockOffsetMhz}" Minimum="-200" Maximum="300" Margin="0,0,0,12" />

                        <!-- Memory Clock (MHz) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Memory Clock Target" Style="{StaticResource TextSecondary}" FontSize="11" />
                            <TextBlock Text="{Binding MemoryClockOffsetMhz, StringFormat={}+{0} MHz}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="{Binding MemoryClockOffsetMhz}" Minimum="-500" Maximum="1000" Margin="0,0,0,12" />

                        <!-- Power Target Limit (%) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Power Target Limit" Style="{StaticResource TextSecondary}" FontSize="11" />
                            <TextBlock Text="{Binding PowerLimitPercent, StringFormat={}{0:0}%}" FontWeight="Bold" Foreground="{StaticResource SonarOrangeBrush}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="{Binding PowerLimitPercent}" Minimum="70" Maximum="115" Margin="0,0,0,12" />

                        <!-- Thermal Limit (°C) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Thermal Limit" Style="{StaticResource TextSecondary}" FontSize="11" />
                            <TextBlock Text="{Binding TempTargetCelsius, StringFormat={}{0:0}°C}" FontWeight="Bold" Foreground="{StaticResource AmberGoldBrush}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Value="{Binding TempTargetCelsius}" Minimum="65" Maximum="90" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
