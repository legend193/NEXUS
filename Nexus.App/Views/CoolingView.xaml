<UserControl x:Class="Nexus.App.Views.CoolingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:conv="clr-namespace:Nexus.App.Converters"
             xmlns:ctrl="clr-namespace:Nexus.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:CoolingViewModel}">

    <UserControl.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Top Header Bar -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentGlowBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,12,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="COOLING &amp; FANS" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="10,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ThermalZoneStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NexusPillButton}" Command="{Binding ResetSafetyDefaultsCommand}" Margin="0,0,8,0" Content="Safety Defaults" />
                        <Button Style="{StaticResource NexusAccentButton}" Command="{Binding ApplyFanCurveCommand}" Height="32" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Stroke="#FFFFFF" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Apply Curve" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Layout: Fan Curve Editor (Left 65%) & Fan Cluster + Presets (Right 35%) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Spline Fan Curve Editor -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCooling}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Fan curve editor" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Cubic Spline Interpolation" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                        </Grid>

                        <!-- Fan Curve Canvas Interactive Surface -->
                        <Border Background="#0D1018" CornerRadius="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="260" Margin="0,0,0,16" Padding="6">
                            <ctrl:FanCurveCanvas Points="{Binding EditableCurvePoints}"
                                                 CurrentTemperature="{Binding SimulatedTemperature}"
                                                 CalculatedSpeed="{Binding SimulatedCalculatedSpeed}" />
                        </Border>

                        <!-- Temperature Source & Manual Override Sub-Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sensor Source Pills -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Source:" Style="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="CPU" Command="{Binding SelectSourceCommand}" CommandParameter="CPU" Style="{StaticResource NexusAccentButton}" Height="30" Padding="12,0" Margin="0,0,6,0" FontSize="11" />
                                <Button Content="GPU" Command="{Binding SelectSourceCommand}" CommandParameter="GPU" Style="{StaticResource NexusPillButton}" Height="30" Padding="12,0" Margin="0,0,6,0" FontSize="11" />
                                <Button Content="VRM" Command="{Binding SelectSourceCommand}" CommandParameter="VRM" Style="{StaticResource NexusPillButton}" Height="30" Padding="12,0" FontSize="11" />
                            </StackPanel>

                            <!-- Manual Override Slider -->
                            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="10" Padding="12,6" Margin="16,0,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Manual:" Style="{StaticResource TextSubtle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider Grid.Column="1" Value="{Binding ManualSpeed}" Minimum="20" Maximum="100" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding ManualSpeed, StringFormat={}{0:0}%}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <CheckBox Grid.Column="3" IsChecked="{Binding IsManualOverrideActive}" Style="{StaticResource NexusToggleSwitch}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Column: Fan Cluster Visual & Presets -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    
                    <!-- Fan Cluster Visual Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFanBlade}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Fan Cluster" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="3x Lian Li AL120" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>

                            <!-- 3 Graphical Fan Hub Circles -->
                            <Border Background="#0D1018" CornerRadius="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                                <UniformGrid Columns="3">
                                    <!-- Fan 1 -->
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="56" Height="56" Margin="0,0,0,6">
                                            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="#1400D2FF" />
                                            <Path Data="{StaticResource IconFanBlade}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Fan1Rpm, StringFormat={}{0:N0} RPM}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Top Exhaust" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Fan 2 -->
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="56" Height="56" Margin="0,0,0,6">
                                            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="#1400D2FF" />
                                            <Path Data="{StaticResource IconFanBlade}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Fan2Rpm, StringFormat={}{0:N0} RPM}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Side Intake" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Fan 3 -->
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="56" Height="56" Margin="0,0,0,6">
                                            <Ellipse Stroke="{StaticResource SonarOrangeBrush}" StrokeThickness="2" Fill="#14FF5500" />
                                            <Path Data="{StaticResource IconAioPump}" Stroke="{StaticResource SonarOrangeBrush}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding FanPumpRpm, StringFormat={}{0:N0} RPM}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SonarOrangeBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="AIO Pump" Style="{StaticResource TextSubtle}" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <!-- Individual Channel Sliders Summary -->
                            <ItemsControl ItemsSource="{Binding FanChannels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Rpm, StringFormat={}{0:N0} RPM}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding TargetPercent, StringFormat={}{0:0}%}" Style="{StaticResource TextSubtle}" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Presets Card -->
                    <Border Style="{StaticResource GlassCard}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Presets" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Acoustics Profile" Style="{StaticResource TextSubtle}" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>

                            <Button Content="Silent (Under 30 dBA)" Command="{Binding SelectPresetCommand}" CommandParameter="Silent" Style="{StaticResource NexusPillButton}" Height="34" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="14,0" />
                            <Button Content="Balanced (Dynamic Curve)" Command="{Binding SelectPresetCommand}" CommandParameter="Balanced" Style="{StaticResource NexusAccentButton}" Height="34" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="14,0" />
                            <Button Content="Performance (High Airflow)" Command="{Binding SelectPresetCommand}" CommandParameter="Performance" Style="{StaticResource NexusPillButton}" Height="34" HorizontalContentAlignment="Left" Padding="14,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
