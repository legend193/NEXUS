<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Base Text Styling -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system, sans-serif" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Glass Card Style (Sonar & iCUE inspired) -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGlassBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InteractiveGlassCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderActiveBrush}" />
                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- SteelSeries Sonar Channel Strip Style -->
    <Style x:Key="SonarChannelStrip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChannelStripBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,16" />
        <Setter Property="Width" Value="180" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SonarOrangeBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Header & Typography -->
    <Style x:Key="HeaderLarge" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="HeaderMedium" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TextSubtle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="TextSecondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Modern Pill Button -->
    <Style x:Key="NexusPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource AccentGlowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Button (Nexus Cyan) -->
    <Style x:Key="NexusAccentButton" TargetType="Button" BasedOn="{StaticResource NexusPillButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0A0D14" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="#33DBFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Pill Button -->
    <Style x:Key="NexusSecondaryButton" TargetType="Button" BasedOn="{StaticResource NexusPillButton}">
        <Setter Property="Background" Value="#1C2130" />
        <Setter Property="BorderBrush" Value="#2D3748" />
        <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>

    <!-- Cyber ToggleSwitch (CheckBox) Style -->
    <Style x:Key="NexusToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <!-- Track -->
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                Background="{StaticResource ToggleUncheckedTrackBrush}"
                                BorderBrush="{StaticResource ToggleTrackBorderBrush}" BorderThickness="1">
                            <!-- Thumb -->
                            <Ellipse x:Name="Thumb" Width="14" Height="14"
                                     Fill="{StaticResource ToggleThumbUncheckedBrush}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleCheckedBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ToggleCheckedBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource ToggleThumbBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sonar Channel Mute Button (Illuminates Red when muted) -->
    <Style x:Key="SonarMuteButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="muteBorder"
                            Background="#181B26"
                            BorderBrush="#252A3B"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Path x:Name="pathMute"
                              Data="{StaticResource IconVolumeOn}"
                              Stroke="#8E95A8"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="muteBorder" Property="Background" Value="#38151D" />
                            <Setter TargetName="muteBorder" Property="BorderBrush" Value="#EF4444" />
                            <Setter TargetName="pathMute" Property="Data" Value="{StaticResource IconVolumeOff}" />
                            <Setter TargetName="pathMute" Property="Stroke" Value="#EF4444" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="muteBorder" Property="BorderBrush" Value="#4A5568" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Sidebar Button Style -->
    <Style x:Key="NavSidebarButton" TargetType="RadioButton">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="navBorder"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="12,0">
                        <Grid>
                            <Rectangle x:Name="activeIndicator"
                                       Width="3" Height="18"
                                       HorizontalAlignment="Left"
                                       RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource AccentBrush}"
                                       Visibility="Collapsed" />

                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="navBorder" Property="Background" Value="{StaticResource CardBgBrush}" />
                            <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Chrome Buttons -->
    <Style x:Key="WindowChromeButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="chromeBorder" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chromeBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sonar Top Nav Tab Button (No fixed width constraint) -->
    <Style x:Key="SonarTabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="closeBorder" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="closeBorder" Property="Background" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Professional SteelSeries Sonar Vertical Fader Style (Exact White Thumb Match) -->
    <Style x:Key="SonarVerticalFader" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="240" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid HorizontalAlignment="Center">
                        <!-- Dark Recessed Fader Track Slot -->
                        <Border Width="4" CornerRadius="2"
                                Background="#0A0B0F"
                                BorderBrush="#1C1F2B"
                                BorderThickness="1"
                                HorizontalAlignment="Center" />

                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="24" Height="11" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <!-- Sonar White Rectangular Thumb -->
                                            <Border CornerRadius="2"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SteelSeries Sonar ChatMix Horizontal Slider -->
    <Style x:Key="SonarChatMixSlider" TargetType="Slider">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Height" Value="24" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Dark Recessed Slot -->
                        <Border Height="4" CornerRadius="2"
                                Background="#0A0B0F"
                                BorderBrush="#1C1F2B"
                                BorderThickness="1"
                                VerticalAlignment="Center" />

                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="11" Height="22" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <!-- Sonar White Vertical Thumb -->
                                            <Border CornerRadius="2"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard Horizontal Glowing Slider -->
    <Style x:Key="NexusSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource BorderSubtleBrush}" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border CornerRadius="8"
                                                    Background="{StaticResource AccentBrush}"
                                                    BorderBrush="#0A0D14"
                                                    BorderThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
