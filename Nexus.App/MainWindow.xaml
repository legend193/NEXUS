<ui:FluentWindow x:Class="Nexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Nexus.App.ViewModels"
        xmlns:views="clr-namespace:Nexus.App.Views"
        xmlns:nav="clr-namespace:Nexus.App.Navigation"
        xmlns:conv="clr-namespace:Nexus.App.Converters"
        mc:Ignorable="d"
        Title="NEXUS — Unified PC Control Center"
        Icon="Assets/nexus_logo.ico"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">

    <ui:FluentWindow.Resources>
        <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />

        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RgbStudioViewModel}">
            <views:RgbStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioStudioViewModel}">
            <views:AudioStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareMonitorViewModel}">
            <views:HardwareMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CoolingViewModel}">
            <views:CoolingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutomationViewModel}">
            <views:AutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginsViewModel}">
            <views:PluginsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <!-- Outer Window Frame with Rounded Corners & Subtle Border -->
    <Border Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="16"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Persistent Sidebar with Compact Mode -->
                <ColumnDefinition Width="220" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="16,0,0,16">

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- App Header / Logo -->
                        <RowDefinition Height="64" />
                        <!-- Navigation Items -->
                        <RowDefinition Height="*" />
                        <!-- Status Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Logo Header -->
                    <Grid Grid.Row="0" Margin="14,0" VerticalAlignment="Center">
                        <!-- NEXUS Wordmark with Official 3D Rig Logo -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource CardBgBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,10,0" Padding="3">
                                <Image Source="Assets/nexus_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NEXUS" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="CONTROL CENTER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type nav:NavigationItem}">
                                    <RadioButton Style="{StaticResource NavSidebarButton}"
                                                 IsChecked="{Binding IsSelected}"
                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}"
                                                 ToolTip="{Binding Title}">
                                        <Grid Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Vector Icon -->
                                            <Path Grid.Column="0"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                  StrokeThickness="1.5"
                                                  Width="15" Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       FontWeight="Medium"
                                                       FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Ecosystem Status -->
                    <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="10" Margin="12,10" Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SystemStatusText}" Style="{StaticResource TextSubtle}" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT MAIN PANEL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Window Title Bar & Header -->
                    <RowDefinition Height="56" />
                    <!-- Dynamic View Content -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title Bar (Draggable) -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        MouseDown="TitleBar_MouseDown">
                    <Grid Margin="24,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Active Section Title -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedNavItem.Title}"
                                   Style="{StaticResource HeaderLarge}"
                                   FontSize="20"
                                   VerticalAlignment="Center" />

                        <!-- Persistent Global Telemetry Capsule -->
                        <Border Grid.Column="1"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,5"
                                Margin="20,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- CPU -->
                                <Path Data="{StaticResource IconHardware}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="CPU " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dashboard.CpuTempText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <Border Width="1" Height="10" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,12,0" />

                                <!-- GPU -->
                                <Path Data="{StaticResource IconPerformance}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="GPU " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dashboard.GpuTempText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <Border Width="1" Height="10" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,12,0" />

                                <!-- RAM -->
                                <TextBlock Text="RAM " Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dashboard.RamPercentText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <Border Width="1" Height="10" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,12,0" />

                                <!-- Active Profile -->
                                <Path Data="{StaticResource IconProfiles}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dashboard.ActiveProfileName}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Window Control Buttons (HUD, Min, Max, Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowChromeButton}" Click="BtnMiniHud_Click" ToolTip="Toggle In-Game Mini HUD" Margin="0,0,6,0">
                                <Path Data="{StaticResource IconSlidersTuning}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                      Width="11" Height="11" Stretch="Uniform" />
                            </Button>

                            <Button Style="{StaticResource WindowChromeButton}" Click="BtnMinimize_Click" ToolTip="Minimize">
                                <Path Data="{StaticResource IconMinimize}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                      Width="10" Height="2" Stretch="Uniform" />
                            </Button>

                            <Button Style="{StaticResource WindowChromeButton}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                                <Path Data="{StaticResource IconMaximize}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2"
                                      Width="10" Height="10" Stretch="Uniform" />
                            </Button>

                            <Button Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Close">
                                <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                      Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Viewport Content -->
                <Border Grid.Row="1" Padding="24,10,24,20">
                    <ContentControl x:Name="MainContentHost" Content="{Binding CurrentViewModel}" />
                </Border>
            </Grid>

        </Grid>
    </Border>
</ui:FluentWindow>
